# @meta description=3-bit QROM lookup + T-phase kick + Berry-Craig-Babbush del_lookup
REGISTER r0 "addr"
APPEND_TO_REGISTER q0 r0
APPEND_TO_REGISTER q1 r0
APPEND_TO_REGISTER q2 r0
INFO_TAG "@enter:init_lookup"
X q2
X q1
INFO_TAG "@enter:init_and"
CCX q2 q1 q6
INFO_TAG "@exit:init_and"
X q1
X q0
INFO_TAG "@enter:init_and"
CCX q6 q0 q7
INFO_TAG "@exit:init_and"
X q0
CX q7 q3
CX q7 q5
CX q6 q7
CX q7 q3
CX q7 q4
INFO_TAG "@enter:del_and"
HMR q7 b0
CZ q6 q0 if b0
BIT_STORE0 b0
INFO_TAG "@exit:del_and"
CX q2 q6
X q0
INFO_TAG "@enter:init_and"
CCX q6 q0 q7
INFO_TAG "@exit:init_and"
X q0
CX q7 q3
CX q7 q4
CX q7 q5
CX q6 q7
CX q7 q4
INFO_TAG "@enter:del_and"
HMR q7 b0
CZ q6 q0 if b0
BIT_STORE0 b0
INFO_TAG "@exit:del_and"
INFO_TAG "@enter:del_and"
HMR q6 b0
CZ q2 q1 if b0
BIT_STORE0 b0
INFO_TAG "@exit:del_and"
X q2
X q1
INFO_TAG "@enter:init_and"
CCX q2 q1 q6
INFO_TAG "@exit:init_and"
X q0
INFO_TAG "@enter:init_and"
CCX q6 q0 q7
INFO_TAG "@exit:init_and"
CX q7 q4
CX q7 q5
INFO_TAG "@enter:del_and"
HMR q7 b0
CZ q6 q0 if b0
BIT_STORE0 b0
INFO_TAG "@exit:del_and"
X q0
INFO_TAG "@enter:del_and"
HMR q6 b0
CZ q2 q1 if b0
BIT_STORE0 b0
INFO_TAG "@exit:del_and"
X q1
INFO_TAG "@exit:init_lookup"
Z q3
Z_POW q4 0.25
INFO_TAG "@enter:del_lookup"
HMR q3 b0
HMR q4 b1
HMR q5 b2
X q2
X q1
INFO_TAG "@enter:init_and"
CCX q2 q1 q6
INFO_TAG "@exit:init_and"
X q1
BIT_STORE0 b3
BIT_INVERT b3 if b0
BIT_INVERT b3 if b2
BIT_STORE0 b4
BIT_INVERT b4 if b0
BIT_INVERT b4 if b1
Z q6 if b3
BIT_INVERT b4 if b3
CZ q6 q0 if b4
BIT_STORE0 b3
BIT_STORE0 b4
CX q2 q6
BIT_STORE0 b3
BIT_INVERT b3 if b0
BIT_INVERT b3 if b1
BIT_INVERT b3 if b2
BIT_STORE0 b4
BIT_INVERT b4 if b1
Z q6 if b3
BIT_INVERT b4 if b3
CZ q6 q0 if b4
BIT_STORE0 b3
BIT_STORE0 b4
INFO_TAG "@enter:del_and"
HMR q6 b5
CZ q2 q1 if b5
BIT_STORE0 b5
INFO_TAG "@exit:del_and"
X q2
X q1
INFO_TAG "@enter:init_and"
CCX q2 q1 q6
INFO_TAG "@exit:init_and"
BIT_STORE0 b3
BIT_INVERT b3 if b1
BIT_INVERT b3 if b2
BIT_STORE0 b4
Z q6 if b3
BIT_INVERT b4 if b3
CZ q6 q0 if b4
BIT_STORE0 b3
BIT_STORE0 b4
INFO_TAG "@enter:del_and"
HMR q6 b5
CZ q2 q1 if b5
BIT_STORE0 b5
INFO_TAG "@exit:del_and"
X q1
BIT_STORE0 b0
BIT_STORE0 b1
BIT_STORE0 b2
INFO_TAG "@exit:del_lookup"
